fn field(p:vec3f)->vec2f {var a=100.0;var b=100.0;var id=0.0;var bi=0.0;for(var i=0u;i<u32(c[24]);i++){let d=primitive(p,i);if(scene[i*16u+10u]>0.5){if(d<b){b=d;bi=f32(i+1u);}}else{if(d<a){a=d;id=f32(i+1u);}}}var d=max(a,-b);if(a<=-b){id=bi;}if(i32(c[5])==4){let v=abs(sin(p*19.0));let lattice=min(v.x,min(v.y,v.z))*0.04-0.009;d=max(abs(d)-0.018,lattice);}return vec2f(d,id);}
fn normal(p:vec3f)->vec3f {let e=0.003;return normalize(vec3f(field(p+vec3f(e,0,0)).x-field(p-vec3f(e,0,0)).x,field(p+vec3f(0,e,0)).x-field(p-vec3f(0,e,0)).x,field(p+vec3f(0,0,e)).x-field(p-vec3f(0,0,e)).x));}
fn texture(p:vec3f)->f32{let q=p*c[15];let x=q.x;let y=q.y;let z=q.z;let k=i32(c[14]);if(k==0){return 0.68+0.32*abs(sin((x+y)*6.0)*sin((x-y)*6.0));}if(k==1){return 0.6+0.4*pow(abs(sin(x*9.0)*sin(y*9.0)*sin(z*7.0)),0.25);}if(k==2){return 0.72+0.28*sin(x*6.0)*sin(y*6.0);}if(k==3){return 0.83+0.17*sin(x*21.0+y*17.0+z*25.0);}if(k==4){return 0.72+0.28*abs(sin(y*15.0));}if(k==5){return 0.62+0.38*abs(sin(x*10.0)*cos(z*10.0));}if(k==6){return 0.55+0.45*clamp(abs(sin(x*5.0+sin(y*7.0)))*4.0,0.0,1.0);}if(k==7){return 0.63+0.37*abs(sin(x*14.0)*sin(y*14.0));}if(k==8){return 1.0;}return 0.57+0.43*abs(sin(x*19.0+y*3.0)*sin(z*23.0+y*17.0));}
fn put(i:u32,v:f32){result[i]=bitcast<u32>(v);}
@compute @workgroup_size(64) fn render_cells(@builtin(global_invocation_id) gid:vec3u){
