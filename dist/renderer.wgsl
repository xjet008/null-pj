@compute @workgroup_size(64) fn raster_pixels(@builtin(global_invocation_id) gid:vec3u){let cw=u32(c[32]);let ch=u32(c[33]);let width=30u*cw;let count=width*30u*ch;let i=gid.x;if(i>=count){return;}let x=i%width;let y=i/width;let cell=(y/ch)*30u+x/cw;let code=u32(base[cell*12u]);let sx=f32(x%cw)*c[34]/f32(cw);let sy=f32(y%ch)*c[35]/f32(ch);let xx=u32(floor(sx));let yy=u32(floor(sy));let a=mix(mask(code,xx,yy),mask(code,xx+1u,yy),fract(sx));let b=mix(mask(code,xx,yy+1u),mask(code,xx+1u,yy+1u),fract(sx));let v=u32(clamp(round(5.0+mix(a,b,fract(sy))*base[cell*12u+1u]),0.0,255.0));result[i]=v|(v<<8u)|(v<<16u)|0xff000000u;}