fn sCurve(v:f32)->f32{let x=clamp(v,0.0,1.0);return x*x*(3.0-2.0*x);}
fn assembled(t:f32)->f32{if(t<0.15){return 0.0;}if(t<0.32){return sCurve((t-0.15)/0.17);}if(t<0.46){return 1.0;}if(t<0.65){return 1.0-sCurve((t-0.46)/0.19);}if(t<0.72){return 0.0;}if(t<0.88){return sCurve((t-0.72)/0.16);}if(t<0.94){return 1.0;}return 1.0-sCurve((t-0.94)/0.06);}
fn fragment(i:u32)->vec3f{
