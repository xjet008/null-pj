@compute @workgroup_size(64) fn clear_depth(@builtin(global_invocation_id) gid:vec3u){if(gid.x<900u){atomicStore(&depths[gid.x],0xffffffffu);}}
@compute @workgroup_size(64) fn project_fragments(@builtin(global_invocation_id) gid:vec3u){let i=gid.x;if(i>=900u||base[i*12u+9u]<0.5||base[i*12u]==32.0){return;}let p=fragment(i);motion[i*3u]=p.x;motion[i*3u+1u]=p.y;motion[i*3u+2u]=p.z;let v=inv(p,c[4],c[3],0);let dep=4.0-v.z;var s=4.0/max(dep,0.25);if(c[1]>0.5){s=1.0;}let x=i32(floor((v.x*s/(c[0]*c[2])+0.5)*30.0));let y=i32(floor((0.5-v.y*s/c[0])*30.0));if(x<0||x>=30||y<0||y>=30||dep<=0.0){return;}let packed=(u32(clamp(round(dep*10000.0),1.0,4000000.0))<<10u)|i;atomicMin(&depths[u32(y*30+x)],packed);}
