 let goal=clamp(0.04+lum*0.32,0.025,0.4);var best=100.0;var char=46u;let seed=u32(c[20]);for(var j=0u;j<u32(c[25]);j++){let code=grammar[j];let d=abs(coverage[code-32u]-goal)+random(seed+cell*131u+code*17u)*0.006;if(d<best){best=d;char=code;}}let v=random(seed+cell*983u);let ent=c[22];let cor=i32(c[21]);if((cor==1&&v<ent*0.45)||(cor==9&&v<ent*0.25)){char=32u;}else if(cor==4&&v<ent){char=grammar[hash32(seed+cell)%u32(c[25])];}else if(cor==5&&v<ent*0.5){char=select(49u,48u,cell%2u==1u);}else if(cor==7&&p.x<0.0&&v<ent){lum*=0.35;}else if(cor==0&&v<ent*0.2){char=46u;}else if(cor==6&&v<ent*0.35){let h=hash32(cell+seed)%16u;char=select(h+55u,h+48u,h<10u);}else if(cor==8&&v<ent*0.3){char=35u;}
 put(off,f32(char));put(off+1u,clamp(65.0+190.0*sqrt(lum),0.0,255.0));put(off+2u,n.x);put(off+3u,n.y);put(off+4u,n.z);put(off+5u,p.x);put(off+6u,p.y);put(off+7u,p.z);put(off+8u,dep);put(off+9u,1.0);put(off+10u,id);put(off+11u,lum);
