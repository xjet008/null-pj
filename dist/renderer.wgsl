 for(var sy=0u;sy<ss;sy++){for(var sx=0u;sx<ss;sx++){let px=((x+(f32(sx)+0.5)/f32(ss))/30.0-0.5)*c[0]*c[2];let py=(0.5-(y+(f32(sy)+0.5)/f32(ss))/30.0)*c[0];var o=vec3f(0,0,4);var d=normalize(vec3f(px,py,-4));if(c[1]>0.5){o=vec3f(px,py,4);d=vec3f(0,0,-1);}o=rot(o,c[4],c[3],0);d=rot(d,c[4],c[3],0);var t=0.0;var hit=false;
