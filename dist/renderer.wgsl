 if(k==2){return length(vec3f(q.x,max(abs(q.y)-s.y,0.0),q.z))-s.x;}
 if(k==3){let a=length(q.xz)-s.x;let b=abs(q.y)-s.y;return min(max(a,b),0.0)+length(max(vec2f(a,b),vec2f(0)));}
