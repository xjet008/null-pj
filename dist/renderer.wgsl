 let destroy=i32(c[30]);if(t>0.46&&t<0.72){if(destroy==1){anchor.y-=b*0.65;}if(destroy==2){anchor.x+=yy*0.7;}if(destroy==3){anchor.y-=r*0.8;}if(destroy==4){anchor=round(anchor*3.0)/3.0;}if(destroy==5){anchor*=0.7+r*0.6;}if(destroy==6){anchor.x+=sin(goal.y*5.0+spin)*0.5;}if(destroy==7){anchor=dispersed;}if(destroy==8){anchor=rot(anchor,0,0,spin);}if(destroy==9){anchor*=0.35;}}
