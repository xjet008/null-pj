const PI:f32=3.141592653589793;
fn hash32(v:u32)->u32 {var x=v;x=x^(x>>16u);x=x*0x7feb352du;x=x^(x>>15u);x=x*0x846ca68bu;return x^(x>>16u);}
fn random(v:u32)->f32{return f32(hash32(v)&0xffffffu)/16777216.0;}
fn rot(p:vec3f,a:f32,b:f32,z:f32)->vec3f {let q=vec3f(p.x,p.y*cos(a)-p.z*sin(a),p.y*sin(a)+p.z*cos(a));let r=vec3f(q.x*cos(b)+q.z*sin(b),q.y,-q.x*sin(b)+q.z*cos(b));return vec3f(r.x*cos(z)-r.y*sin(z),r.x*sin(z)+r.y*cos(z),r.z);}
fn inv(p:vec3f,a:f32,b:f32,z:f32)->vec3f {let q=vec3f(p.x*cos(z)+p.y*sin(z),-p.x*sin(z)+p.y*cos(z),p.z);let r=vec3f(q.x*cos(b)-q.z*sin(b),q.y,q.x*sin(b)+q.z*cos(b));return vec3f(r.x,r.y*cos(a)+r.z*sin(a),-r.y*sin(a)+r.z*cos(a));}
fn box(q:vec3f,s:vec3f)->f32{let a=abs(q)-s;return length(max(a,vec3f(0)))+min(max(a.x,max(a.y,a.z)),0.0);}
fn primitive(p:vec3f,i:u32)->f32{
